<?xml version="1.0" encoding="utf-8"?>
<!-- Deeper levels: a white row. Fixed height whether or not it has a subtitle, so
     the list never resizes per item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/white_row"
    android:orientation="horizontal"
    android:stateListAnimator="@animator/press_scale"
    android:gravity="center_vertical"
    android:paddingStart="11dp"
    android:paddingEnd="11dp">

    <ImageView
        android:id="@+id/rowThumb"
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:background="@drawable/thumb_placeholder_small"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_soft"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
