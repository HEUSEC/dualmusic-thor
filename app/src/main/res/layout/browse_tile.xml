<?xml version="1.0" encoding="utf-8"?>
<!-- Root level of the browse tree: a quiet tile. One surface for every row —
     rotating gradients coloured nothing meaningful, so they are gone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileRoot"
    android:layout_width="match_parent"
    android:layout_height="59dp"
    android:background="@drawable/panel_inset"
    android:orientation="horizontal"
    android:stateListAnimator="@animator/press_scale"
    android:gravity="center_vertical"
    android:padding="11dp">

    <ImageView
        android:id="@+id/tileThumb"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:background="@drawable/thumb_placeholder"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="2dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
