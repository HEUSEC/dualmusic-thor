<?xml version="1.0" encoding="utf-8"?>
<!-- FAR SCREEN — 1920x1080, never touched, read at arm's length.
     No badges, no chips: hierarchy is size, weight and space. The cover is shown
     whole over a blurred copy of itself, so no part of the artwork is cut away. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/npShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shell"
        android:padding="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/npArtCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="@drawable/art_card"
            android:clipToOutline="true">

            <!-- The cover again, filled and blurred: gives the card the record's colour
                 without cropping anything the eye is meant to see. -->
            <ImageView
                android:id="@+id/npBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <View
                android:id="@+id/npBackdropVeil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#8CF4F7F3" />

            <ImageView
                android:id="@+id/npArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="18dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/artwork" />

            <View
                android:id="@+id/npPausedScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#57F4F7F3"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/npMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/npSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:singleLine="true" />

            <TextView
                android:id="@+id/npTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/ink"
                android:textSize="40sp"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.98"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_artist"
                android:textSize="20sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/npAlbum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            </LinearLayout>

            <!-- Lyrics take whatever room is left, and the whole shell in reading mode.
                 No panel, no border: the white plate on the current line is the only
                 chrome, and it means "you are here". -->
            <ScrollView
                android:id="@+id/npLyricsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="22dp"
                android:fadingEdgeLength="28dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/npLyricsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical" />
            </ScrollView>

            <!-- A spacer that only exists when there are no lyrics, so the times stay
                 pinned to the bottom either way. -->
            <View
                android:id="@+id/npFiller"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/npProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:progressDrawable="@drawable/progress_accent"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/npElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/npTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/npEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shell"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/no_session"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_session_hint"
            android:textColor="@color/ink_soft"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
