<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lyrics are fetched from LRCLIB at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The local library. Asked for at the point of use, and refused is a supported
         state: without it the "On this device" row is simply not in the browse root. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Playback outlives the activity, which is what a foreground service is for; the
         wake lock is what keeps it going with the screen off. POST_NOTIFICATIONS is
         only for the transport notification that service is required to show. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The equaliser is an AudioEffect, and an effect on an audio session is an audio
         setting. Normal permission, granted at install; refused it, the setting is
         simply not offered. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- allowBackup is off on purpose: the Spotify refresh token lives in
             SharedPreferences, and cloud backup would carry it off the device. -->

        <!-- resizeableActivity + a plain task make it legal to relaunch this
             activity on the secondary display via ActivityOptions.setLaunchDisplayId(). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives dualmusic://auth after the Web API consent page. Exported because
             the browser has to reach it; the code it carries is only redeemed when the
             state matches the request we sent (see SpotifyWebAuth). -->
        <activity
            android:name=".SpotifyRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dualmusic" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- Our own player, for the files on this device. Not exported: it is started
             by this app alone, and everything else reaches it through the MediaSession
             it publishes, which is the same door every other player uses. -->
        <service
            android:name=".LocalPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The only reason this service exists: holding notification-listener access is
             what unlocks MediaSessionManager.getActiveSessions() for a normal app. -->
        <service
            android:name=".MediaNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
