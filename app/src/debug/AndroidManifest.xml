<?xml version="1.0" encoding="utf-8"?>
<!--
    The probe is a diagnostic, launched by hand from adb, so it has to be exported — and
    an exported activity is one any app on the device can start. It therefore lives in
    the debug build only: a release APK does not contain it at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <activity
            android:name=".SpotifyProbeActivity"
            android:exported="true" />

    </application>
</manifest>
